# Entity: subscription

main: kit: entity: subscription: {

  alias: field: {}

  fields: [
    {
      name: "protocol"
      req: false
      short: "VPN protocol to use"
      type: "`$STRING`"
    }
    {
      name: "server"
      req: false
      short: "VPN server address"
      type: "`$STRING`"
    }
  ]

  name: "subscription"
  op: {
    load: {
      name: "load"
      points: [
        {
          contract: {
            id: "GET /api/demo"
            json: "{\"operationId\":\"getDemoSubscription\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"config\":{\"description\":\"VPN configuration details for the demo subscription\",\"properties\":{\"protocol\":{\"description\":\"VPN protocol to use\",\"type\":\"string\"},\"server\":{\"description\":\"VPN server address\",\"type\":\"string\"}},\"type\":\"object\"},\"expiry\":{\"description\":\"Expiration date and time of the demo subscription\",\"format\":\"date-time\",\"type\":\"string\"},\"subscription\":{\"description\":\"Demo subscription identifier or access token\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Successful response with demo subscription details\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message describing what went wrong\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Bad request - Invalid parameters\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message describing the server issue\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/api/demo"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "demo"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.config`"
          }
        }
      ]
    }
  }



}
