# Entity: subscription

main: kit: entity: subscription: {

  alias: field: {}

  fields: [
    {
      name: "protocol"
      req: false
      short: "VPN protocol to use"
      type: "`$STRING`"
    }
    {
      name: "server"
      req: false
      short: "VPN server address"
      type: "`$STRING`"
    }
  ]

  name: "subscription"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/demo"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "demo"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.config`"
          }
        }
      ]
    }
  }



}
